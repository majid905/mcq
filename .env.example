# Copy to .env and fill in. Never commit real values.
# Per-app overrides: apps/api/.env, apps/web/.env.local, apps/admin/.env.local

NODE_ENV=development

# --- MySQL 8.4 ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=mcq
MYSQL_USER=mcq
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
DATABASE_URL=mysql://mcq:change-me@127.0.0.1:3306/mcq

# --- Redis 7 ---
REDIS_URL=redis://127.0.0.1:6379

# --- Meilisearch ---
MEILI_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=change-me-meili

# --- API ---
API_PORT=3000
JWT_ACCESS_SECRET=change-me-access

# --- Seed: super admin ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin

# --- Web / Admin (default to the Prism mock server) ---
NEXT_PUBLIC_API_BASE=http://localhost:4010/v1

# --- API extras ---
LOG_LEVEL=info
# Web (student) and admin dev servers; API owns :3000 (matches openapi.yaml servers)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Reverse-proxy hops in front of the API (0 locally, 1 behind nginx)
TRUST_PROXY=0

# --- Auth ---
# console = log the OTP and accept 123456 (dev only, refused when NODE_ENV=production); http = real gateway
SMS_DRIVER=console
# SMS_HTTP_URL=https://sms-gateway.example.com/send
# SMS_HTTP_API_KEY=
# SMS_SENDER_ID=

# Payments (PAYMENT_DRIVER=fake needs nothing; live needs the sandbox/live credentials below)
PAYMENT_DRIVER=fake
PUBLIC_API_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3001
APP_SCHEME=mcqapp
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_LIVE=false
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_LIVE=false

# Uploads: leave R2_* empty to store files in UPLOAD_DIR (dev/staging)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
UPLOAD_DIR=./.uploads
