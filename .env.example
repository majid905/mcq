# Copy to .env and fill in. Never commit real values.
# Per-app overrides: apps/api/.env, apps/web/.env.local, apps/admin/.env.local

NODE_ENV=development

# --- MySQL 8.4 ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=mcq
MYSQL_USER=mcq
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
DATABASE_URL=mysql://mcq:change-me@127.0.0.1:3306/mcq

# --- Redis 7 ---
REDIS_URL=redis://127.0.0.1:6379

# --- Meilisearch ---
MEILI_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=change-me-meili

# --- API ---
API_PORT=3000
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# --- Seed: super admin ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin

# --- Web / Admin (default to the Prism mock server) ---
NEXT_PUBLIC_API_BASE=http://localhost:4010/v1

# --- API extras ---
LOG_LEVEL=info
# Web (student) and admin dev servers; API owns :3000 (matches openapi.yaml servers)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
