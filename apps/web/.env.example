# Copy to .env.local. Default is the Prism mock (pnpm mock); use http://localhost:3000/v1 for the real API.
NEXT_PUBLIC_API_BASE=http://localhost:4010/v1

# Landing page and footer. Store badges, social icons and the support email stay hidden until set.
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
