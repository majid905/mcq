{
  "name": "@mcq/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API: http (main), worker and scheduler entry points.",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:scheduler": "node dist/scheduler.js",
    "search:reindex": "node dist/search/reindex.js",
    "admin:create": "node dist/admin/create-admin.js",
    "dev": "nest start --watch",
    "dev:worker": "nest start --entryFile worker --watch",
    "dev:scheduler": "nest start --entryFile scheduler --watch",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "jest",
    "test:contract": "jest --config test/contract/jest.config.cjs --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "ioredis": "^5.8.0",
    "mammoth": "^1.13.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.13.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mcq/config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.0"
  }
}
