{
  "name": "@mcq/api-client-ts",
  "version": "0.0.0",
  "private": true,
  "description": "Generated TypeScript API client. Never edit src/generated by hand; run pnpm contract:gen.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "gen": "openapi-typescript ../api-contract/openapi.yaml -o src/generated/schema.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@mcq/config": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^10.13.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
