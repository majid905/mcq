{
  "name": "mcq-platform",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@mcq/web --filter=@mcq/admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:contract": "turbo run test:contract",
    "e2e": "turbo run e2e",
    "mock": "pnpm --filter @mcq/api-contract run mock",
    "mock:dynamic": "pnpm --filter @mcq/api-contract run mock:dynamic",
    "contract:gen": "node scripts/contract-gen.mjs",
    "tokens:gen": "pnpm --filter @mcq/design-tokens run gen",
    "db:reset": "pnpm --filter @mcq/database run reset",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.0"
  }
}
