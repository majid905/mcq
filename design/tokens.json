{
  "$description": "Design tokens shared by web (CSS variables via Tailwind v4 @theme) and Flutter (ThemeData + ThemeExtension). Generated by `pnpm tokens:gen` into packages/design-tokens/dist/tokens.css and apps/mobile/lib/core/theme/tokens.g.dart. Never hardcode these values.",
  "color": {
    "light": {
      "bg":             "#F7F8F6",
      "surface":        "#FFFFFF",
      "surfaceMuted":   "#F0F2EF",
      "surfaceSunken":  "#E8ECE8",
      "border":         "#DDE3DE",
      "borderStrong":   "#C3CCC5",
      "text":           "#14201B",
      "textMuted":      "#55635C",
      "textSubtle":     "#646F69",
      "primary":        "#0F766E",
      "primaryHover":   "#0B5F58",
      "primarySoft":    "#E3F3F1",
      "onPrimary":      "#FFFFFF",
      "accent":         "#E39B14",
      "accentSoft":     "#FDF2DC",
      "accentText":     "#92640D",
      "onAccent":       "#1F1503",
      "live":           "#C52E46",
      "liveSoft":       "#FDE7EA",
      "success":        "#147C3B",
      "successSoft":    "#E3F5E9",
      "danger":         "#C62828",
      "dangerSoft":     "#FCE8E8",
      "warning":        "#B45309",
      "warningSoft":    "#FEF1E2",
      "info":           "#1D4ED8",
      "infoSoft":       "#E5ECFD",
      "focusRing":      "#0F766E",
      "overlay":        "rgba(20,32,27,0.48)"
    },
    "dark": {
      "bg":             "#0D1412",
      "surface":        "#141D1A",
      "surfaceMuted":   "#1A2521",
      "surfaceSunken":  "#0A100E",
      "border":         "#26332E",
      "borderStrong":   "#38473F",
      "text":           "#E8EEEA",
      "textMuted":      "#A3B1AA",
      "textSubtle":     "#7F8F87",
      "primary":        "#2DBDAE",
      "primaryHover":   "#4FD1C3",
      "primarySoft":    "#12302C",
      "onPrimary":      "#04201C",
      "accent":         "#F2B53D",
      "accentSoft":     "#33270E",
      "accentText":     "#F2B53D",
      "onAccent":       "#1F1503",
      "live":           "#FF5A73",
      "liveSoft":       "#3A1820",
      "success":        "#3FCB74",
      "successSoft":    "#13301F",
      "danger":         "#F2706B",
      "dangerSoft":     "#3A1A19",
      "warning":        "#F2A55A",
      "warningSoft":    "#36230F",
      "info":           "#7EA4FF",
      "infoSoft":       "#16233F",
      "focusRing":      "#2DBDAE",
      "overlay":        "rgba(0,0,0,0.6)"
    }
  },
  "option": {
    "$description": "Answer option tile states, light/dark both derived from color tokens",
    "idle":     { "bg": "surface",      "border": "border",   "badgeBg": "surfaceMuted", "badgeText": "textMuted" },
    "selected": { "bg": "primarySoft",  "border": "primary",  "badgeBg": "primary",      "badgeText": "onPrimary" },
    "correct":  { "bg": "successSoft",  "border": "success",  "badgeBg": "success",      "badgeText": "onPrimary" },
    "wrong":    { "bg": "dangerSoft",   "border": "danger",   "badgeBg": "danger",       "badgeText": "onPrimary" },
    "missed":   { "bg": "surface",      "border": "success",  "badgeBg": "successSoft",  "badgeText": "success" }
  },
  "font": {
    "family": {
      "bangla": "Hind Siliguri",
      "latin": "Inter",
      "mono": "JetBrains Mono",
      "stackWeb": "'Inter', 'Hind Siliguri', 'Noto Sans Bengali', system-ui, sans-serif",
      "flutterFallback": ["Hind Siliguri", "Noto Sans Bengali"]
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "size": {
      "display": 32, "h1": 26, "h2": 22, "h3": 18, "body": 16, "bodySm": 14, "caption": 12, "overline": 11,
      "question": 17, "option": 16, "timer": 20, "stat": 28
    },
    "lineHeight": { "tight": 1.25, "normal": 1.5, "relaxed": 1.7 },
    "$note": "Bangla glyphs need ≥1.5 line height; question and option text uses relaxed (1.7). Use tabular numerals for timers and scores."
  },
  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 24, "pill": 999 },
  "border": { "hairline": 1, "strong": 2 },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px rgba(20,32,27,0.06)",
    "md": "0 4px 16px rgba(20,32,27,0.08)",
    "lg": "0 12px 32px rgba(20,32,27,0.12)"
  },
  "motion": {
    "duration": { "instant": 80, "fast": 150, "base": 220, "slow": 320 },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "emphasized": "cubic-bezier(0.3, 0, 0, 1.2)", "exit": "cubic-bezier(0.4, 0, 1, 1)" },
    "$note": "Respect reduced-motion: disable non-essential animation."
  },
  "size": {
    "touchMin": 48, "buttonHeight": 52, "buttonHeightSm": 40, "inputHeight": 52,
    "appBar": 56, "bottomNav": 68, "optionMinHeight": 56, "maxContentWeb": 1120, "maxReadingWeb": 720
  },
  "breakpoint": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280 },
  "zIndex": { "sticky": 10, "drawer": 40, "modal": 50, "toast": 60 }
}
