# Copy to /srv/mcq/backup.env (mode 600). Read by backup-mysql.sh and restore-drill.sh.

MYSQL_CONTAINER=mcq-prod-mysql-1
MYSQL_DATABASE=mcq
BACKUP_DIR=/srv/mcq/backups
BACKUP_KEEP_LOCAL_DAYS=7

# A long random passphrase in its own file (mode 600): head -c 48 /dev/urandom | base64 > /srv/mcq/backup.pass
# Keep a copy of it OUTSIDE the server (password manager). Without it the backups cannot be read.
BACKUP_PASSPHRASE_FILE=/srv/mcq/backup.pass

# Cloudflare R2 (a separate bucket from the images; write-only key for the server is ideal)
BACKUP_UPLOAD=1
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=mcq-backups
R2_BACKUP_PREFIX=db-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: node_exporter textfile collector directory, enables the BackupStale alert
METRICS_TEXTFILE_DIR=
